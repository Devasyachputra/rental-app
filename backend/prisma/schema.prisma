generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooled connection (Supabase pgbouncer, port 6543)
  directUrl = env("DIRECT_URL")   // direct connection (port 5432), dipakai saat migrate
}

enum Transmission {
  Manual
  Matic
}

model Car {
  id           String        @id @default(uuid())
  name         String // Nama Kendaraan
  brand        String? // Merk
  transmission Transmission  @default(Matic)
  seats        Int           @default(5)
  pricePerDay  Int           @map("price_per_day")
  photoUrl     String?       @map("photo_url")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  @@map("cars")
}

// Single-row config table (id selalu = 1) untuk nomor WA tujuan checkout
model Settings {
  id             Int      @id @default(1)
  whatsappNumber String   @map("whatsapp_number")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

// Akun owner/admin untuk login ke panel admin (JWT auth, dikelola sendiri oleh backend)
model Admin {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String?
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("admins")
}

// Tabel "Daftar Harga Sewa Lengkap" — beda dari Car (katalog unit per-mobil).
// Ini per TIPE kendaraan (mis. "Ayla / Agya"), dengan 4 tingkat tarif.
model PriceRate {
  id             String   @id @default(uuid())
  vehicleType    String   @map("vehicle_type") // mis. "Toyota Avanza / Xenia"
  inCityHalfDay  Int      @map("in_city_half_day") // Dalam Kota (12 Jam)
  inCityFullDay  Int      @map("in_city_full_day") // Dalam Kota (Full Day)
  outCityHalfDay Int      @map("out_city_half_day") // Luar Kota (12 Jam)
  outCityFullDay Int      @map("out_city_full_day") // Luar Kota (Full Day)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("price_rates")
}
