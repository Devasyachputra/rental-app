# Supabase Postgres connection strings
# DATABASE_URL: pooled connection (pgbouncer, port 6543) - dipakai runtime app
# DIRECT_URL: direct connection (port 5432) - dipakai saat `prisma migrate`/`db push`
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres"

# Ganti dengan string acak yang panjang & rahasia (mis. hasil `openssl rand -hex 32`)
JWT_SECRET="ganti-dengan-secret-yang-sangat-rahasia"

PORT=4000

# Origin frontend yang diizinkan mengakses API (pisahkan koma jika lebih dari satu)
CORS_ORIGIN="http://localhost:5173"

NODE_ENV=development
